        {
          "name": "R4 - Registro valido (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{correoGenerado}}\",\n  \"confirmation_email\": \"{{correoGenerado}}\",\n  \"names\": \"Test\",\n  \"surnames\": \"R4\",\n  \"password\": \"clave1234\",\n  \"phone_number\": \"+56911111111\",\n  \"rut\": \"{{rutGenerado}}\",\n  \"country\": \"Chile\",\n  \"region\": \"La Araucanía\",\n  \"city\": \"Temuco\",\n  \"institution\": \"Test\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function calcularDV(cuerpo) {",
                  "    let suma = 0, factor = 2;",
                  "    for (let i = cuerpo.length - 1; i >= 0; i--) {",
                  "        suma += parseInt(cuerpo[i]) * factor;",
                  "        factor = (factor === 7) ? 2 : factor + 1;",
                  "    }",
                  "    const resto = 11 - (suma % 11);",
                  "    if (resto === 11) return '0';",
                  "    if (resto === 10) return 'K';",
                  "    return String(resto);",
                  "}",
                  "const cuerpo = String(Math.floor(10000000 + Math.random() * 15000000));",
                  "const dv = calcularDV(cuerpo);",
                  "pm.variables.set('rutGenerado', cuerpo + '-' + dv);",
                  "pm.variables.set('correoGenerado', 'caso' + Date.now() + Math.floor(Math.random() * 10000) + '@ejemplo.cl');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es uno de [201]', function () {",
                  "    pm.expect([201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
